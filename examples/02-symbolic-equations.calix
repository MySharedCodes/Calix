{
  "format": "calix-notebook",
  "version": 1,
  "title": "02-symbolic-equations",
  "cells": [
    {
      "id": "example-0",
      "mode": "source",
      "code": "Assuming[x>0,Simplify[Sqrt[x^2]]]"
    },
    {
      "id": "example-1",
      "mode": "source",
      "code": "D[x^3 y^2,{x,2},y]"
    },
    {
      "id": "example-2",
      "mode": "source",
      "code": "Integrate[Exp[-x^2],x]"
    },
    {
      "id": "example-3",
      "mode": "source",
      "code": "Integrate[Exp[-a x],{x,0,Infinity}]"
    },
    {
      "id": "example-4",
      "mode": "source",
      "code": "Solve[{x+y==3,x-y==1},{x,y}]"
    },
    {
      "id": "example-5",
      "mode": "source",
      "code": "RSolve[{a[n+1]==2 a[n]+1,a[0]==0},a[n],n]"
    },
    {
      "id": "example-6",
      "mode": "source",
      "code": "DSolve[{y''[x]+y[x]==0,y[0]==1,y'[0]==0},y[x],x]"
    }
  ]
}