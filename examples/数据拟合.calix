{
  "format": "calix-notebook",
  "version": 1,
  "title": "数据拟合",
  "cells": [
    {
      "id": "example-0",
      "mode": "source",
      "code": "Clear[a,r,f,v,x,y,t,n];\nd={{0,0.1},{1,2.2},{2,4.0},{3,6.1},{4,7.9},{5,10.2}};\nf=Fit[d,{1,x},x];\nr=Table[Part[q,2]-ReplaceAll[f,x->Part[q,1]],{q,d}];\ns=Total[Table[e^2,{e,r}]];\ny₁=Table[Part[q,2],{q,d}];\nr₂=1-s/Total[Table[(y-Mean[y₁])^2,{y,y₁}]];\nf\nN[r₂,8]\nN[Sqrt[s/Length[d]],8]\nShow[ListPlot[d],Plot[f,{x,0,5},PlotLegends->{\"linear fit\"}]]\nListPlot[Table[{Part[d,i,1],Part[r,i]},{i,1,Length[d]}]]"
    },
    {
      "id": "example-1",
      "mode": "source",
      "code": "Clear[a,r,f,v,x,y,t,n];\nd={{0,1.1},{1,3.9},{2,8.8},{3,16.2},{4,25.1},{5,35.9}};\nf=Fit[d,{1,x,x^2},x];\nr=Table[Part[q,2]-ReplaceAll[f,x->Part[q,1]],{q,d}];\nf\nN[Sqrt[Mean[Table[e^2,{e,r}]]],8]\nShow[ListPlot[d],Plot[f,{x,0,5},PlotLegends->{\"quadratic fit\"}]]\nListPlot[Table[{Part[d,i,1],Part[r,i]},{i,1,Length[d]}]]"
    },
    {
      "id": "example-2",
      "mode": "source",
      "code": "Clear[a,r,f,v,x,y,t,n];\nd={{0,10.1},{1,7.2},{2,5.3},{3,3.8},{4,2.7},{5,2.0}};\nd₂=Table[{Part[q,1],Log[Part[q,2]]},{q,d}];\nf₂=Fit[d₂,{1,x},x];\nf=Exp[f₂];\nr=Table[Part[q,2]-ReplaceAll[f,x->Part[q,1]],{q,d}];\nN[f,8]\nN[Sqrt[Mean[Table[e^2,{e,r}]]],8]\nShow[ListPlot[d],Plot[f,{x,0,5},PlotLegends->{\"exponential fit\"}]]\nListPlot[Table[{Part[d,i,1],Part[r,i]},{i,1,Length[d]}]]"
    }
  ]
}